BOT_TOKEN=your_bot_token_here
SUPPORT_GROUP_ID=-100your_group_id_here

# Bearer-токены для GET /admin/db через запятую, один на человека.
# Пусто = эндпоинт отключён. Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_DB_TOKENS=

# Порт admin-сервера. На Railway подставляется автоматически через PORT.
ADMIN_PORT=8080

# Кодовое слово hard-reset юзера (отправить в топик). Пусто = дефолт !user_del!
RESET_KEYWORD=!user_del!

# Фидбек: «вопрос решён?» → оценка 1-5
FEEDBACK_ENABLED=true
# Через сколько часов после последнего ответа саппорта спрашивать. На dev — 0
FEEDBACK_DELAY_HOURS=2
# Как часто тикает sweeper (минуты)
FEEDBACK_SWEEP_INTERVAL_MIN=5
